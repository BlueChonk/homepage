# 高德地图 Web端(JS API) Key
# 申请地址: https://console.amap.com/dev/key/app
VITE_AMAP_API_KEY=YOUR_AMAP_WEB_JS_KEY
# 高德「安全密钥/jscode」：若开启联合鉴权则填入，否则留空
VITE_AMAP_SECURITY_JS_CODE=

# Bangumi Access Token
# 申请地址: https://next.bgm.tv/demo/access-token
# 只需 Token，无需配置用户名（脚本会自动通过 /v0/me 获取）
BANGUMI_TOKEN=YOUR_BANGUMI_ACCESS_TOKEN
