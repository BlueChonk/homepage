---
import Icon from './Icons.astro'
import { PROJECTS } from '../data/site'
---
<section id="projects" class="reveal">
  <h2 class="section-title">项目仓库</h2>
  <p class="section-sub">从模型复现到服务部署的一些学习与实践记录</p>
  <div class="cards">
    {
      PROJECTS.map((p) => (
        <a class="card" href={p.href} target="_blank" rel="noopener">
          <div class="card-head">
            <h3>{p.title}</h3>
            <Icon name="external" />
          </div>
          <p>{p.desc}</p>
          <div class="tags">
            {p.tags.map((t) => (
              <span class={`tag ${t.variant}`.trim()}>{t.label}</span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</section>
