---
import { getCollection } from 'astro:content'

const posts = (await getCollection('blog'))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .slice(-3)
  .reverse()
---
<section id="blog" class="reveal">
  <h2 class="section-title">笔记</h2>
  <p class="section-sub">Docker / FRP / MinIO / HTTPS / 向量模型等部署笔记</p>
  <div class="cards">
    {
      posts.map((p) => (
        <a class="card post-card" href={`/blog/${p.slug}/`}>
          <div class="card-head">
            <h3>{p.data.title}</h3>
          </div>
          <p>{p.data.summary}</p>
          <div class="post-foot">
            <span class="post-meta">{p.data.date.toISOString().slice(0, 10)}</span>
            <span class="tags">
              {p.data.tags.map((t) => <span class="tag">{t}</span>)}
            </span>
          </div>
        </a>
      ))
    }
  </div>
  <div class="blog-more">
    <a class="more-link" href="/blog">查看全部笔记 →</a>
  </div>
</section>
