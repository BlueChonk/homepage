---
import Icon from './Icons.astro'
// 回到顶部悬浮按钮：滚动超过阈值后浮现，点击平滑置顶
const { threshold = 320 } = Astro.props
---

<button id="backTop" class="back-top" type="button" aria-label="回到顶部" title="回到顶部" hidden>
  <Icon name="arrowUp" size={22} />
</button>

<script is:inline define:vars={{ threshold }}>
  (function () {
    const btn = document.getElementById('backTop')
    if (!btn) return

    const onScroll = () => {
      const show = window.scrollY > threshold
      if (show && btn.hidden) btn.hidden = false
      if (!show && !btn.hidden) btn.hidden = true
    }
    onScroll()
    window.addEventListener('scroll', onScroll, { passive: true })
    window.addEventListener('resize', onScroll)

    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' })
    })
  })()
</script>
